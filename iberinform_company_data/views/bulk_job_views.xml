<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iberinform_bulk_job_list" model="ir.ui.view">
        <field name="name">iberinform.bulk.job.list</field>
        <field name="model">iberinform.bulk.job</field>
        <field name="arch" type="xml">
            <list string="Atualizações Iberinform em lotes" create="0" delete="0">
                <field name="name"/>
                <field name="state" widget="badge"/>
                <field name="requested_by"/>
                <field name="total_count"/>
                <field name="completed_count"/>
                <field name="partial_count"/>
                <field name="failed_count"/>
                <field name="blocked_count"/>
                <field name="pending_count"/>
                <field name="next_run_at"/>
            </list>
        </field>
    </record>
    <record id="view_iberinform_bulk_job_form" model="ir.ui.view">
        <field name="name">iberinform.bulk.job.form</field>
        <field name="model">iberinform.bulk.job</field>
        <field name="arch" type="xml">
            <form string="Atualização Iberinform em lotes" create="0" delete="0">
                <header>
                    <button name="action_run_one_batch" type="object" string="Processar lote disponível"
                            class="btn-primary" invisible="state != 'queued'"/>
                    <button name="action_resume" type="object" string="Retomar após confirmar acesso"
                            class="btn-primary" invisible="state != 'paused'"/>
                    <button name="action_cancel" type="object" string="Cancelar fila"
                            class="btn-secondary" invisible="state not in ('queued', 'paused')"/>
                    <button name="action_refresh" type="object" string="Atualizar estado"
                            class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="queued,paused,done,cancelled"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="state != 'queued'">
                        A fila pode avançar automaticamente em segundo plano.
                        As datas usam o fuso horário das suas Preferências.
                        Clique em «Atualizar estado» para consultar os últimos resultados.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="state != 'paused'">
                        Consulta interrompida por HTTP 403/429. Não serão feitos novos pedidos
                        até retomar manualmente.
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="requested_by" readonly="1"/>
                            <field name="batch_size" readonly="1"/>
                        </group>
                        <group>
                            <field name="last_batch_at" readonly="1"/>
                            <field name="next_run_at" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="total_count" readonly="1"/>
                        <field name="completed_count" readonly="1"/>
                        <field name="partial_count" readonly="1"/>
                        <field name="failed_count" readonly="1"/>
                        <field name="blocked_count" readonly="1"/>
                        <field name="pending_count" readonly="1"/>
                    </group>
                    <field name="last_error" readonly="1" invisible="not last_error"/>
                    <notebook>
                        <page string="Empresas / Resultado">
                            <field name="line_ids" nolabel="1" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="partner_id"/>
                                    <field name="vat"/>
                                    <field name="state" widget="badge"/>
                                    <field name="processed_at"/>
                                    <field name="error" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_iberinform_bulk_job_list" model="ir.actions.act_window">
        <field name="name">Histórico de atualizações Iberinform</field>
        <field name="res_model">iberinform.bulk.job</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
